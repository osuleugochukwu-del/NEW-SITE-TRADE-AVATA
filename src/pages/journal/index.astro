---
import PrivateAppLayout from '../../layouts/PrivateAppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<PrivateAppLayout title="Trade Avata — Trading Journal">
  <div class="journal-app" id="journalApp">
    <header class="journal-topbar">
      <div class="top-left">
        <a class="journal-brand" href={base} aria-label="Trade Avata home">
          <img src={`${base}brand/trade-avata-logo.svg`} alt="Trade Avata" />
          <span>Trade Avata</span>
        </a>
        <span class="slash">/</span>
        <span class="crumb">My Trading</span>
        <span class="slash">/</span>
        <strong class="crumb-current">Journal</strong>
      </div>
      <div class="top-actions">
        <span class="sync-pill" id="syncStatus"><i></i> Local</span>
        <button class="top-btn" id="exportBtn" title="Export journal">Export</button>
        <button class="top-btn" id="importBtn" title="Import journal">Import</button>
        <input id="importFile" type="file" accept="application/json" hidden />
        <button class="top-btn ai-top" id="aiReviewBtn">✦ AI Review</button>
        <button class="top-btn primary" id="newTradeBtn">New</button>
      </div>
    </header>

    <div class="journal-layout">
      <aside class="journal-sidebar">
        <div class="side-heading">
          <div class="workspace-mark">✦</div>
          <div><strong>TRADING JOURNAL</strong><small id="userState">Personal workspace</small></div>
        </div>
        <button class="side-create" id="newTradeSide">＋ New trade</button>
        <nav class="side-nav" aria-label="Journal views">
          <button class="active" data-view="all">▦ <span>All trades</span><em id="allCount">0</em></button>
          <button data-view="today">◷ <span>Today</span></button>
          <button data-view="reviews">✎ <span>Reviews</span></button>
          <button data-view="gallery">▧ <span>Gallery</span></button>
        </nav>
        <div class="side-group">
          <label>VIEWS</label>
          <button data-filter="wins"><b class="dot win"></b>Winning trades</button>
          <button data-filter="losses"><b class="dot loss"></b>Losing trades</button>
          <button data-filter="open"><b class="dot open"></b>Incomplete</button>
        </div>
        <div class="side-group">
          <label>LIBRARY</label>
          <button id="strategiesBtn">◇ <span>Strategies</span><em id="strategyCount">0</em></button>
          <button id="propertiesBtn">☷ <span>Properties</span></button>
        </div>
        <div class="side-bottom">
          <div class="storage-note"><span>⌁</span><div><strong>Saved automatically</strong><small>Your journal stays on this device.</small></div></div>
          <button id="resetJournalBtn">↺ Reset demo data</button>
        </div>
      </aside>

      <main class="journal-main">
        <section class="journal-header">
          <div>
            <div class="eyebrow">TRADING JOURNAL</div>
            <h1 id="journalTitle">June</h1>
            <p>Turn every trade into evidence you can review, learn from and build on.</p>
          </div>
          <div class="header-stats">
            <div><span>Trades</span><strong id="statTrades">0</strong></div>
            <div><span>Reviewed</span><strong id="statReviewed">0%</strong></div>
            <div><span>Wins</span><strong id="statWins">0</strong></div>
          </div>
        </section>

        <section class="database-toolbar">
          <div class="view-tabs">
            <button class="active" data-main-view="table">▤ Table</button>
            <button data-main-view="gallery">▦ Gallery</button>
            <button id="addPropertyBtn">＋ Property</button>
          </div>
          <div class="database-actions">
            <div class="search-box"><span>⌕</span><input id="tradeSearch" placeholder="Search trades…" /></div>
            <button id="filterBtn">≡ Filter</button>
            <button id="sortBtn">↕ Sort</button>
          </div>
        </section>

        <section class="database" id="database">
          <div class="database-scroll">
            <table class="journal-table" id="journalTable">
              <thead><tr id="tableHead"></tr></thead>
              <tbody id="tradeBody"></tbody>
            </table>
          </div>
          <button class="new-row" id="newRowBtn">＋ New</button>
          <div class="database-footer" id="tableFooter"></div>
        </section>

        <section class="gallery-view" id="galleryView" hidden></section>
        <section class="reviews-view" id="reviewsView" hidden>
          <div class="reviews-intro"><div class="ai-badge">✦</div><div><div class="eyebrow">AI JOURNAL REVIEW</div><h2>Review the decisions behind your trades.</h2><p>Select any trade to inspect its evidence, execution and lessons. AI only works from what you recorded.</p></div></div>
          <div id="reviewCards" class="review-cards"></div>
        </section>
        <section class="library-view" id="libraryView" hidden></section>
      </main>
    </div>

    <div class="drawer-backdrop" id="drawerBackdrop"></div>
    <aside class="trade-drawer" id="tradeDrawer" aria-hidden="true">
      <div class="drawer-top">
        <button class="drawer-close" id="closeDrawer" aria-label="Close">×</button>
        <div class="drawer-title-wrap"><span class="eyebrow">TRADE RECORD</span><h2 id="drawerTitle">AUDUSD</h2><span id="drawerSub">June 5, 2024</span></div>
        <div class="drawer-actions"><button class="drawer-btn" id="duplicateTradeBtn">Duplicate</button><button class="drawer-btn primary" id="saveTradeBtn">Save</button></div>
      </div>
      <div class="drawer-scroll">
        <div class="record-section first"><div class="section-title"><strong>Properties</strong><span>Click any value to edit</span></div><div class="property-grid" id="propertyGrid"></div></div>
        <div class="record-section"><div class="section-title"><strong>Decision</strong><span>Why did I take it?</span></div>
          <label class="field"><span>Thesis</span><textarea id="fThesis" placeholder="What did you see, and why did the trade make sense?"></textarea></label>
          <label class="field"><span>Confluences</span><textarea id="fConfluences" placeholder="Sweep, CIS, displacement, MSS, FVG…"></textarea></label>
          <label class="field"><span>Execution notes</span><textarea id="fExecution" placeholder="Entry, stop, target, management, hesitation…"></textarea></label>
        </div>
        <div class="record-section"><div class="section-title"><strong>Review</strong><span>Separate setup quality from outcome</span></div>
          <div class="ratings"><label><span>Setup quality <output id="setupRatingOut">7</output>/10</span><input id="fSetupRating" type="range" min="1" max="10" value="7" /></label><label><span>Execution quality <output id="executionRatingOut">7</output>/10</span><input id="fExecutionRating" type="range" min="1" max="10" value="7" /></label></div>
          <label class="field"><span>Lesson</span><textarea id="fLesson" placeholder="What will you repeat, change or avoid next time?"></textarea></label>
          <label class="field"><span>Evidence / chart link</span><input id="fEvidence" placeholder="Paste a chart image URL or note where the evidence is stored" /></label>
        </div>
        <div class="record-section ai-section">
          <div class="ai-head"><div class="ai-orb">✦</div><div><strong>Trade Avata AI</strong><span>Evidence-based journal review</span></div><button class="drawer-btn" id="runDrawerAI">Analyze</button></div>
          <div class="ai-output" id="aiOutput">AI will compare your recorded thesis, confirmations, strategy, execution and outcome. Missing information is shown instead of invented.</div>
        </div>
      </div>
    </aside>

    <div class="modal" id="propertyModal" hidden>
      <div class="modal-card large">
        <button class="modal-close" id="closePropertyModal">×</button>
        <div class="eyebrow">JOURNAL SETUP</div><h2>Make the journal yours.</h2><p>Create properties once and they become available on every trade.</p>
        <div class="modal-tabs"><button class="active" data-manager="properties">Properties</button><button data-manager="strategies">Strategies</button></div>
        <div id="propertyManager">
          <div class="create-line"><input id="propertyInput" placeholder="Property name, e.g. Emotion" /><select id="propertyType"><option value="text">Text</option><option value="select">Select</option><option value="multi">Multi-select</option><option value="number">Number</option><option value="date">Date</option><option value="checkbox">Checkbox</option></select><button class="drawer-btn primary" id="createPropertyBtn">Add</button></div>
          <div class="manager-list" id="propertyList"></div>
        </div>
        <div id="strategyManager" hidden>
          <div class="create-line"><input id="strategyInput" placeholder="Strategy name, e.g. Liquidity Sweep" /><button class="drawer-btn primary" id="createStrategyBtn">＋ Save strategy</button></div>
          <div class="manager-help">Create a strategy once. It becomes a reusable choice whenever you journal a trade.</div>
          <div class="manager-list" id="strategyList"></div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ base, aiEndpoint: import.meta.env.PUBLIC_TRADE_AVATA_AI_ENDPOINT || '', projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || '' }}>
    import { auth, watchAuth } from '../../lib/firebase/auth.js';
    import { db } from '../../lib/firebase/db.js';
    import { doc, getDoc, setDoc, serverTimestamp } from 'firebase/firestore';

    const seedTrades = [
      {id:'t1',symbol:'EURUSD',position:'BUY',session:'NYKZ',date:'2024-06-03',type:'CONTINUATION',confirmation:['ENGULFING'],rr:'1:2RR',entryTF:'1H',risk:'0.5%',forecast:'HIGH PROBABILITY ENTRY',strategy:'Liquidity Sweep',outcome:true,notes:{thesis:'HTF bullish structure with a clean liquidity sweep into the level.',confluences:'Sweep · CIS · MSS · FVG',execution:'Entered after confirmation; no early exit.',lesson:'Keep the trigger objective.',setupRating:8,executionRating:9}},
      {id:'t2',symbol:'AUDUSD',position:'SELL',session:'NYKZ',date:'2024-06-03',type:'REVERSAL',confirmation:['FVG','MSS'],rr:'1:2RR',entryTF:'1H',risk:'0.5%',forecast:'LOW RISK ENTRY',strategy:'Reversal',outcome:false,notes:{thesis:'Reversal after rejection from a higher-timeframe level.',confluences:'Sweep · CIS',execution:'Exited early after hesitation.',lesson:'Do not change the plan because of a temporary pullback.',setupRating:7,executionRating:5}},
      {id:'t3',symbol:'AUDUSD',position:'BUY',session:'ASKZ',date:'2024-06-05',type:'CONTINUATION',confirmation:['SWEEP','CIS','DISPLACEMENT','MSS','FVG'],rr:'1:2RR',entryTF:'1H',risk:'0.5%',forecast:'HIGH PROBABILITY ENTRY',strategy:'Continuation',outcome:true,notes:{thesis:'Continuation after sweep and displacement.',confluences:'SWEEP · CIS · DISPLACEMENT · MSS · FVG',execution:'Waited for confirmation before entry.',lesson:'Keep confirmation sequence consistent.',setupRating:9,executionRating:9}}
    ];
    const defaultStrategies=['Liquidity Sweep','Continuation','Reversal'];
    const storageKey='trade-avata-journal-v3';
    const strategyKey='trade-avata-journal-strategies-v2';
    const propertyKey='trade-avata-journal-properties-v2';
    let trades=JSON.parse(localStorage.getItem(storageKey)||'null')||seedTrades;
    let strategies=JSON.parse(localStorage.getItem(strategyKey)||'null')||defaultStrategies;
    let customProperties=JSON.parse(localStorage.getItem(propertyKey)||'null')||[];
    let selectedId=trades[0]?.id||null;
    let activeFilter='all';
    let activeView='table';
    let currentUser=null;
    const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
    const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
    const keyLabel=k=>k.replace(/([A-Z])/g,' $1').replace(/^./,x=>x.toUpperCase());
    const dayName=date=>new Date(date+'T12:00:00').toLocaleDateString('en-US',{weekday:'long'}).toUpperCase();
    const formatDate=date=>date?new Date(date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}):'';
    function persistLocal(){localStorage.setItem(storageKey,JSON.stringify(trades));localStorage.setItem(strategyKey,JSON.stringify(strategies));localStorage.setItem(propertyKey,JSON.stringify(customProperties));setSync('Local');}
    function setSync(label,good=true){const el=$('#syncStatus');if(el){el.innerHTML=`<i class="${good?'good':''}"></i> ${esc(label)}`;}}
    function workspaceData(){return {trades,strategies,customProperties,updatedAt:serverTimestamp()};}
    async function syncCloud(){if(!currentUser||!db)return;try{await setDoc(doc(db,'journalWorkspaces',currentUser.uid),workspaceData(),{merge:true});setSync('Synced',true)}catch(e){setSync('Local',false)}}
    async function loadCloud(user){currentUser=user;if(!user){setSync('Local');return;}$('#userState').textContent=user.displayName||user.email||'Signed-in workspace';if(!db){setSync('Local');return;}try{const snap=await getDoc(doc(db,'journalWorkspaces',user.uid));if(snap.exists()){const d=snap.data();if(Array.isArray(d.trades))trades=d.trades;if(Array.isArray(d.strategies))strategies=d.strategies;if(Array.isArray(d.customProperties))customProperties=d.customProperties;localStorage.setItem(storageKey,JSON.stringify(trades));localStorage.setItem(strategyKey,JSON.stringify(strategies));localStorage.setItem(propertyKey,JSON.stringify(customProperties);render();}await syncCloud()}catch(e){setSync('Local',false)}}
    function persist(){persistLocal();clearTimeout(window.__cloudTimer);window.__cloudTimer=setTimeout(syncCloud,500);}
    function filtered(){const q=($('#tradeSearch')?.value||'').toLowerCase().trim();const today=new Date().toISOString().slice(0,10);return trades.filter(t=>{if(activeFilter==='wins'&&t.outcome!==true)return false;if(activeFilter==='losses'&&t.outcome!==false)return false;if(activeFilter==='open'&&t.outcome!==null)return false;if(activeView==='today'&&t.date!==today)return false;return !q||JSON.stringify(t).toLowerCase().includes(q)});}
    function tag(text,cls='neutral'){return text?`<span class="tag ${cls}">${esc(text)}</span>`:''}
    function render(){
      const rows=filtered();
      $('#tableHead').innerHTML='<th class="trade-name-col">TRADE</th><th>POSITION</th><th>SESSION</th><th>DATE</th><th>DOW</th><th>TRADE TYPE</th><th>CONFIRMATION</th><th>RR</th><th>ENTRY TF</th><th>NXT RISK</th><th>FORECAST</th><th>STRATEGY</th><th>OUTCOME</th><th></th>';
      $('#tradeBody').innerHTML=rows.map(t=>`<tr data-id="${esc(t.id)}" class="${selectedId===t.id?'selected':''}"><td class="trade-name-col"><span class="row-icon">▱</span><b>${esc(t.symbol||'Untitled trade')}</b></td><td>${tag(t.position,t.position==='BUY'?'buy':'sell')}</td><td>${tag(t.session)}</td><td>${esc(formatDate(t.date))}</td><td>${tag(t.dow||dayName(t.date),t.dow==='TUESDAY'?'pink':'green')}</td><td>${tag(t.type,'yellow')}</td><td>${(t.confirmation||[]).slice(0,4).map(x=>tag(x,'purple')).join(' ')}${(t.confirmation||[]).length>4?tag('+'+((t.confirmation||[]).length-4),'gray'):''}</td><td>${tag(t.rr,'peach')}</td><td>${tag(t.entryTF)}</td><td>${tag(t.risk,'blue')}</td><td>${tag(t.forecast,t.forecast?.includes('LOW')?'gray':'purple')}</td><td>${tag(t.strategy||'Add strategy','strategy')}</td><td><span class="check ${t.outcome===true?'checked':''}">${t.outcome===true?'✓':''}</span></td><td><button class="row-more" data-more="${esc(t.id)}">•••</button></td></tr>`).join('');
      $$('#tradeBody tr').forEach(r=>r.onclick=e=>{if(e.target.closest('.row-more'))return;openTrade(r.dataset.id)});
      $('#allCount').textContent=trades.length;$('#strategyCount').textContent=strategies.length;
      const reviewed=trades.filter(t=>t.notes?.lesson||t.notes?.execution).length;$('#statTrades').textContent=trades.length;$('#statWins').textContent=trades.filter(t=>t.outcome===true).length;$('#statReviewed').textContent=(trades.length?Math.round(reviewed/trades.length*100):0)+'%';
      $('#tableFooter').innerHTML=`<span>COUNT ${rows.length}</span><span>CHECKED ${trades.filter(t=>t.outcome!==null).length}</span><span>REVIEWED ${reviewed}</span><span>COMPLETION ${trades.length?Math.round(trades.filter(t=>t.outcome!==null).length/trades.length*100):0}%</span>`;
      renderGallery(rows);renderReviews();renderProperties();renderStrategies();
    }
    function renderGallery(rows){$('#galleryView').innerHTML=rows.map(t=>`<button class="gallery-card" data-gallery-id="${esc(t.id)}"><div class="gallery-top"><span>${tag(t.position,t.position==='BUY'?'buy':'sell')}</span><span>${esc(formatDate(t.date))}</span></div><h3>${esc(t.symbol||'Untitled trade')}</h3><p>${esc(t.strategy||'No strategy selected')}</p><div>${(t.confirmation||[]).slice(0,3).map(x=>tag(x,'purple')).join(' ')}</div><footer><span>RR ${esc(t.rr||'—')}</span><span>${t.outcome===true?'✓ Reviewed outcome':t.outcome===false?'Loss / review':'Incomplete'}</span></footer></button>`).join('')||'<div class="empty-state">No trades match this view.</div>';$$('[data-gallery-id]').forEach(b=>b.onclick=()=>openTrade(b.dataset.galleryId));}
    function renderReviews(){const items=[...trades].filter(t=>t.notes?.lesson||t.notes?.execution);$('#reviewCards').innerHTML=items.map(t=>`<button class="review-card" data-review-id="${esc(t.id)}"><div><span class="review-symbol">${esc(t.symbol)}</span>${tag(t.strategy||'No strategy','strategy')}</div><p>${esc(t.notes?.lesson||t.notes?.execution||'No review recorded yet.')}</p><footer><span>Setup ${esc(t.notes?.setupRating||'—')}/10</span><span>Execution ${esc(t.notes?.executionRating||'—')}/10</span><span>${esc(formatDate(t.date))}</span></footer></button>`).join('')||'<div class="empty-state">Complete a trade review and it will appear here.</div>';$$('[data-review-id]').forEach(b=>b.onclick=()=>openTrade(b.dataset.reviewId));}
    function openTrade(id){selectedId=id;const t=trades.find(x=>x.id===id);if(!t)return;$('#drawerTitle').textContent=t.symbol||'Untitled trade';$('#drawerSub').textContent=formatDate(t.date);$('#tradeDrawer').classList.add('open');$('#drawerBackdrop').classList.add('open');$('#tradeDrawer').setAttribute('aria-hidden','false');renderDrawer(t);render();}
    function renderDrawer(t){
      const fields=[['POSITION','position','select',['BUY','SELL']],['CONFIRMATION','confirmation','tags'],['DATE','date','date'],['ENTRY TF','entryTF','select',['1m','5m','15m','30m','1H','4H','1D','1W']],['RR','rr','text'],['NXT RISK','risk','text'],['DOW','dow','select',['MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY']],['FORECAST','forecast','text'],['TRADE TYPE','type','select',['CONTINUATION','REVERSAL','BREAKOUT','PULLBACK','RANGE']],['SESSION','session','select',['NYKZ','ASKZ','LONDON','NEW YORK','ASIA','SYDNEY']],['STRATEGY','strategy','strategy'],['OUTCOME','outcome','checkbox']];
      $('#propertyGrid').innerHTML=fields.map(([label,key,type,opts])=>{const v=t[key];if(type==='checkbox')return `<label class="prop-row"><span>${label}</span><input data-field="${key}" type="checkbox" ${v===true?'checked':''}/></label>`;if(type==='select')return `<label class="prop-row"><span>${label}</span><select data-field="${key}">${opts.map(o=>`<option value="${esc(o)}" ${o===v?'selected':''}>${esc(o)}</option>`).join('')}</select></label>`;if(type==='strategy')return `<label class="prop-row"><span>${label}</span><div class="strategy-select"><select data-field="${key}"><option value="">Select strategy…</option>${strategies.map(o=>`<option value="${esc(o)}" ${o===v?'selected':''}>${esc(o)}</option>`).join('')}</select><button type="button" id="quickStrategy">＋</button></div></label>`;if(type==='tags')return `<label class="prop-row"><span>${label}</span><input data-field="${key}" value="${esc((v||[]).join(', '))}" placeholder="Sweep, MSS, FVG…" /></label>`;return `<label class="prop-row"><span>${label}</span><input data-field="${key}" type="${type}" value="${esc(v||'')}" /></label>`}).join('')+customProperties.map(p=>customField(p,t)).join('');
      $('#fThesis').value=t.notes?.thesis||'';$('#fConfluences').value=t.notes?.confluences||'';$('#fExecution').value=t.notes?.execution||'';$('#fLesson').value=t.notes?.lesson||'';$('#fEvidence').value=t.notes?.evidence||'';$('#fSetupRating').value=t.notes?.setupRating||7;$('#fExecutionRating').value=t.notes?.executionRating||7;$('#setupRatingOut').value=$('#fSetupRating').value;$('#executionRatingOut').value=$('#fExecutionRating').value;$('#aiOutput').textContent='AI review is ready. It will use only the information recorded in this trade.';
      $('#quickStrategy')?.addEventListener('click',()=>openManager('strategies'));
    }
    function customField(p,t){const v=t.custom?.[p.id]??'';if(p.type==='checkbox')return `<label class="prop-row"><span>${esc(p.name.toUpperCase())}</span><input data-custom-field="${esc(p.id)}" type="checkbox" ${v===true?'checked':''}/></label>`;if(p.type==='select')return `<label class="prop-row"><span>${esc(p.name.toUpperCase())}</span><input data-custom-field="${esc(p.id)}" value="${esc(v)}" placeholder="Type or select" /></label>`;return `<label class="prop-row"><span>${esc(p.name.toUpperCase())}</span><input data-custom-field="${esc(p.id)}" type="${p.type==='number'?'number':p.type==='date'?'date':'text'}" value="${esc(v)}" /></label>`;}
    function collectTrade(){const t=trades.find(x=>x.id===selectedId);if(!t)return null;$('#propertyGrid').querySelectorAll('[data-field]').forEach(el=>{const k=el.dataset.field;if(el.type==='checkbox')t[k]=el.checked;else if(k==='confirmation')t[k]=el.value.split(',').map(x=>x.trim()).filter(Boolean);else t[k]=el.value});t.dow=dayName(t.date);t.custom=t.custom||{};$('#propertyGrid').querySelectorAll('[data-custom-field]').forEach(el=>t.custom[el.dataset.customField]=el.type==='checkbox'?el.checked:el.value);t.notes={...(t.notes||{}),thesis:$('#fThesis').value,confluences:$('#fConfluences').value,execution:$('#fExecution').value,lesson:$('#fLesson').value,evidence:$('#fEvidence').value,setupRating:Number($('#fSetupRating').value),executionRating:Number($('#fExecutionRating').value)};return t;}
    function saveTrade(){const t=collectTrade();if(!t)return;persist();openTrade(t.id);$('#saveTradeBtn').textContent='Saved';setTimeout(()=>$('#saveTradeBtn').textContent='Save',900);}
    function newTrade(){const id='t'+Date.now();const now=new Date();const date=now.toISOString().slice(0,10);trades.unshift({id,symbol:'NEW TRADE',position:'BUY',session:'NYKZ',date,dow:dayName(date),type:'CONTINUATION',confirmation:[],rr:'1:2RR',entryTF:'1H',risk:'0.5%',forecast:'',strategy:strategies[0]||'',outcome:null,notes:{}});persist();render();openTrade(id);}
    function duplicateTrade(){const t=trades.find(x=>x.id===selectedId);if(!t)return;const copy=JSON.parse(JSON.stringify(t));copy.id='t'+Date.now();copy.symbol=t.symbol+' copy';trades.unshift(copy);persist();render();openTrade(copy.id);}
    function renderProperties(){const el=$('#propertyList');if(!el)return;el.innerHTML=customProperties.map(p=>`<div class="manager-item"><span class="property-icon">☷</span><strong>${esc(p.name)}</strong><small>${esc(p.type)}</small><button data-delete-property="${esc(p.id)}">×</button></div>`).join('')||'<div class="manager-empty">No custom properties yet.</div>';$$('[data-delete-property]').forEach(b=>b.onclick=()=>{customProperties=customProperties.filter(p=>p.id!==b.dataset.deleteProperty);persist();render()});}
    function renderStrategies(){const el=$('#strategyList');if(!el)return;el.innerHTML=strategies.map(s=>`<div class="manager-item"><span class="strategy-icon">◇</span><strong>${esc(s)}</strong><small>Reusable</small><button data-delete-strategy="${esc(s)}">×</button></div>`).join('')||'<div class="manager-empty">No strategies yet.</div>';$$('[data-delete-strategy]').forEach(b=>b.onclick=()=>{strategies=strategies.filter(s=>s!==b.dataset.deleteStrategy);persist();render()});}
    function openManager(which='properties'){$('#propertyModal').hidden=false;$$('[data-manager]').forEach(b=>b.classList.toggle('active',b.dataset.manager===which));$('#propertyManager').hidden=which!=='properties';$('#strategyManager').hidden=which!=='strategies';renderProperties();renderStrategies();}
    function switchMain(view){activeView=view;$('#database').hidden=view!=='table';$('#galleryView').hidden=view!=='gallery';$('#reviewsView').hidden=view!=='reviews';$('#libraryView').hidden=true;$$('[data-main-view]').forEach(b=>b.classList.toggle('active',b.dataset.mainView===view));render();}
    function runLocalAI(t){const n=t.notes||{};const missing=[];if(!t.strategy)missing.push('strategy');if(!n.thesis)missing.push('thesis');if(!n.execution)missing.push('execution notes');if(!n.confluences)missing.push('confluences');const adherence=t.strategy&&n.thesis&&n.execution?'The recorded entry contains the main evidence needed to compare the plan with execution.':'The journal is missing some decision evidence, so adherence cannot be fully assessed.';const outcome=t.outcome===true?'The recorded outcome is marked positive.':t.outcome===false?'The recorded outcome is marked negative.':'The outcome is still incomplete.';return `<strong>Summary</strong><p>${esc(adherence)} ${esc(outcome)}</p><strong>Recorded evidence</strong><p>Strategy: ${esc(t.strategy||'not recorded')}. Confirmation: ${esc((t.confirmation||[]).join(', ')||'not recorded')}. Setup ${esc(n.setupRating||'—')}/10; execution ${esc(n.executionRating||'—')}/10.</p><strong>Missing evidence</strong><p>${missing.length?esc(missing.join(', ')):'Nothing essential from the journal fields is currently missing.'}</p><strong>Next review point</strong><p>${esc(n.lesson||'Record one specific lesson so the next review can compare this trade with future trades.')}</p>`;}
    const resolvedAIEndpoint=aiEndpoint || (projectId ? `https://us-central1-${projectId}.cloudfunctions.net/reviewJournal` : '');
    async function runAI(t){const output=$('#aiOutput');output.innerHTML='<span class="ai-loading">✦ Reviewing your journal evidence…</span>';const n=t.notes||{};const evidence={symbol:t.symbol,position:t.position,session:t.session,date:t.date,tradeType:t.type,confirmation:t.confirmation||[],rr:t.rr,entryTF:t.entryTF,risk:t.risk,forecast:t.forecast,strategy:t.strategy||null,outcome:t.outcome,thesis:n.thesis||'',confluences:n.confluences||'',execution:n.execution||'',setupRating:n.setupRating||null,executionRating:n.executionRating||null,lesson:n.lesson||'',custom:t.custom||{}};if(resolvedAIEndpoint){try{const token=auth?.currentUser?await auth.currentUser.getIdToken():'';const res=await fetch(resolvedAIEndpoint,{method:'POST',headers:{'Content-Type':'application/json',...(token?{Authorization:`Bearer ${token}`}:{})},body:JSON.stringify({evidence})});if(!res.ok)throw new Error(String(res.status));const data=await res.json();output.innerHTML=esc(data?.report||data?.summary||'AI review completed.').replace(/\n/g,'<br>');return}catch(e){}}
      output.innerHTML=runLocalAI(t);
    }
    function exportJournal(){const payload={version:3,exportedAt:new Date().toISOString(),trades,strategies,customProperties};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='trade-avata-journal.json';a.click();URL.revokeObjectURL(a.href);}
    function importJournal(file){const reader=new FileReader();reader.onload=()=>{try{const d=JSON.parse(reader.result);if(!Array.isArray(d.trades))throw new Error('Invalid journal');trades=d.trades;strategies=Array.isArray(d.strategies)?d.strategies:strategies;customProperties=Array.isArray(d.customProperties)?d.customProperties:customProperties;persist();render();if(trades[0])openTrade(trades[0].id);}catch(e){alert('That journal file could not be imported.')}};reader.readAsText(file);}

    $('#newTradeBtn').onclick=newTrade;$('#newTradeSide').onclick=newTrade;$('#newRowBtn').onclick=newTrade;$('#saveTradeBtn').onclick=saveTrade;$('#duplicateTradeBtn').onclick=duplicateTrade;$('#closeDrawer').onclick=()=>{$('#tradeDrawer').classList.remove('open');$('#drawerBackdrop').classList.remove('open')};$('#drawerBackdrop').onclick=()=>$('#closeDrawer').click();$('#tradeSearch').oninput=render;$('#filterBtn').onclick=()=>{activeFilter=activeFilter==='all'?'wins':activeFilter==='wins'?'losses':activeFilter==='losses'?'open':'all';$('#filterBtn').textContent=`≡ ${activeFilter==='all'?'Filter':activeFilter}`;render()};$('#sortBtn').onclick=()=>{trades.sort((a,b)=>b.date.localeCompare(a.date));persist();render()};$('#aiReviewBtn').onclick=()=>selectedId?runAI(trades.find(t=>t.id===selectedId)):null;$('#runDrawerAI').onclick=()=>{const t=collectTrade();if(t){persist();runAI(t)}};$('#fSetupRating').oninput=e=>$('#setupRatingOut').value=e.target.value;$('#fExecutionRating').oninput=e=>$('#executionRatingOut').value=e.target.value;
    $('#strategiesBtn').onclick=()=>openManager('strategies');$('#propertiesBtn').onclick=()=>openManager('properties');$('#addPropertyBtn').onclick=()=>openManager('properties');$('#closePropertyModal').onclick=()=>$('#propertyModal').hidden=true;$$('[data-manager]').forEach(b=>b.onclick=()=>openManager(b.dataset.manager));$('#createPropertyBtn').onclick=()=>{const name=$('#propertyInput').value.trim();if(!name)return;customProperties.push({id:'p'+Date.now(),name,type:$('#propertyType').value});$('#propertyInput').value='';persist();render()};$('#createStrategyBtn').onclick=()=>{const v=$('#strategyInput').value.trim();if(!v)return;if(!strategies.includes(v))strategies.push(v);$('#strategyInput').value='';persist();render();};$('#resetJournalBtn').onclick=()=>{if(confirm('Reset the journal demo data?')){trades=seedTrades.map(t=>JSON.parse(JSON.stringify(t)));strategies=[...defaultStrategies];customProperties=[];persist();render();openTrade(trades[0].id)}};
    $$('[data-filter]').forEach(b=>b.onclick=()=>{activeFilter=activeFilter===b.dataset.filter?'all':b.dataset.filter;render();});$$('[data-view]').forEach(b=>b.onclick=()=>{const view=b.dataset.view;$$('[data-view]').forEach(x=>x.classList.toggle('active',x===b));if(view==='gallery')switchMain('gallery');else if(view==='reviews')switchMain('reviews');else{activeView=view==='today'?'table':'table';switchMain('table');if(view==='today')activeFilter='all';}});$$('[data-main-view]').forEach(b=>b.onclick=()=>switchMain(b.dataset.mainView));
    $('#exportBtn').onclick=exportJournal;$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=e=>e.target.files[0]&&importJournal(e.target.files[0]);
    watchAuth(loadCloud);
    render();if(selectedId)openTrade(selectedId);
  </script>

